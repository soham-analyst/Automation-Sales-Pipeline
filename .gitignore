# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example

# Logs and databases
logs/*
!logs/.gitkeep
*.log
*.sqlite
*.sqlite3
*.db

# Data Pipeline Runtime Output (keep directory structure via .gitkeep)
data/processed/*
!data/processed/.gitkeep
data/archive/*
!data/archive/.gitkeep
data/rejected/*
!data/rejected/.gitkeep

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.ruff_cache/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Operating System
.DS_Store
Thumbs.db
desktop.ini
